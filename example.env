# Copy to .env (gitignored), or to a per-tenant file outside the repo and use --env-file.

CXONE_BASE_URL=https://ast.checkmarx.net
CXONE_TENANT=<your-tenant-name>
CXONE_API_KEY=<your-api-key>
CXONE_DEBUG=false

# Optional
# CXONE_IAM_BASE_URL=https://iam.checkmarx.net
# Output CSV path (default: api_keys.csv)
# CXONE_OUTPUT=api_keys.csv
